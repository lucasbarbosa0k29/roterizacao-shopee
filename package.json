    "@types/rbush": "^4.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.24",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.23",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5"
