    "@turf/bbox": "^7.3.3",
    "@turf/boolean-intersects": "^7.3.3",
    "@turf/boolean-point-in-polygon": "^7.3.3",
    "@turf/buffer": "^7.3.3",
    "@turf/helpers": "^7.3.3",
    "bcrypt": "^6.0.0",
    "driver.js": "^1.4.0",
    "fakefilter": "^1.1.1600",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "prisma": "6.19.3",
    "rbush": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
